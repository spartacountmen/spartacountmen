<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>확률 기반 로또 추첨기</title>
    <style>
        /* 기본 모바일 최적화 스타일 */
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        h1 {
            font-size: 24px;
            margin-bottom: 5px;
            text-align: center;
            color: #fbc400;
        }
        
        .subtitle {
            font-size: 13px;
            color: #9ca3af;
            margin-bottom: 30px;
            text-align: center;
        }

        /* 로또 공 디자인 */
        .ball-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 40px;
            min-height: 60px;
            width: 100%;
            max-width: 350px;
            flex-wrap: wrap;
        }

        .ball {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 20px;
            font-weight: bold;
            color: white;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.6);
            box-shadow: inset -5px -5px 15px rgba(0,0,0,0.4), 0 4px 6px rgba(0,0,0,0.3);
            opacity: 0;
            transform: scale(0.5);
            animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes popIn {
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* 한국 로또 공식 색상 */
        .color-yellow { background: radial-gradient(circle at 15px 15px, #fde047, #eab308); color: #333; text-shadow: none; }
        .color-blue { background: radial-gradient(circle at 15px 15px, #7dd3fc, #0ea5e9); }
        .color-red { background: radial-gradient(circle at 15px 15px, #fca5a5, #ef4444); }
        .color-gray { background: radial-gradient(circle at 15px 15px, #d1d5db, #6b7280); }
        .color-green { background: radial-gradient(circle at 15px 15px, #bef264, #84cc16); }

        /* 추첨 버튼 */
        .draw-btn {
            background-color: #3b82f6;
            color: white;
            border: none;
            border-radius: 30px;
            padding: 16px 32px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
            transition: transform 0.1s, background-color 0.2s;
            width: 100%;
            max-width: 350px;
        }

        .draw-btn:active {
            transform: scale(0.95);
            background-color: #2563eb;
        }

        /* 추첨 기록 */
        .history-section {
            margin-top: 40px;
            width: 100%;
            max-width: 350px;
        }

        .history-title {
            font-size: 16px;
            color: #9ca3af;
            margin-bottom: 10px;
            border-bottom: 1px solid #374151;
            padding-bottom: 5px;
        }

        .history-item {
            background-color: #1f2937;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
            color: #e5e7eb;
        }

        .history-nums {
            letter-spacing: 1px;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <h1>행운의 로또 추첨기</h1>
    <div class="subtitle">역대 최다 당첨 번호 확률 가중치 적용됨</div>

    <div class="ball-container" id="ballContainer"></div>

    <button class="draw-btn" id="drawBtn" onclick="generateLotto()">고확률 번호 뽑기</button>

    <div class="history-section">
        <div class="history-title">최근 추첨 기록</div>
        <div id="historyList"></div>
    </div>

    <script>
        // 번호에 따른 색상 클래스 반환
        function getBallColor(number) {
            if (number >= 1 && number <= 10) return 'color-yellow';
            if (number >= 11 && number <= 20) return 'color-blue';
            if (number >= 21 && number <= 30) return 'color-red';
            if (number >= 31 && number <= 40) return 'color-gray';
            if (number >= 41 && number <= 45) return 'color-green';
            return 'color-gray';
        }

        // 역대 로또 최다 출현 번호 기반 가중치 설정 (확률 우위 세팅)
        // 숫자가 클수록 추첨함(Pool)에 더 많이 들어가 당첨 확률이 상승합니다.
        const frequencyWeights = {
            // 1그룹 (역대 최다 당첨 번호 Top 10) : 확률 5배 적용
            43: 5, 34: 5, 1: 5, 27: 5, 13: 5, 17: 5, 39: 5, 33: 5, 40: 5, 14: 5,
            
            // 2그룹 (자주 나오는 번호 Top 11~20) : 확률 3배 적용
            20: 3, 18: 3, 10: 3, 4: 3, 2: 3, 45: 3, 12: 3, 19: 3, 21: 3, 38: 3
        };

        function generateLotto() {
            const btn = document.getElementById('drawBtn');
            const container = document.getElementById('ballContainer');
            
            btn.disabled = true;
            container.innerHTML = '';

            // 가중치를 적용한 확률 풀(Pool) 생성
            let probabilityPool = [];
            for (let i = 1; i <= 45; i++) {
                let weight = frequencyWeights[i] || 1; // 명시되지 않은 번호는 기본 가중치 1
                for (let w = 0; w < weight; w++) {
                    probabilityPool.push(i);
                }
            }

            // 중복 없이 6개 번호 추출
            let selectedNumbers = [];
            while(selectedNumbers.length < 6) {
                // 확률 풀에서 랜덤하게 하나를 선택
                let randomIndex = Math.floor(Math.random() * probabilityPool.length);
                let pickedNum = probabilityPool[randomIndex];
                
                // 이미 뽑힌 번호가 아니라면 배열에 추가
                if(!selectedNumbers.includes(pickedNum)) {
                    selectedNumbers.push(pickedNum);
                }
            }

            // 오름차순 정렬
            selectedNumbers.sort((a, b) => a - b);

            // 0.3초 간격으로 화면에 표시하는 애니메이션 효과
            selectedNumbers.forEach((num, index) => {
                setTimeout(() => {
                    const ball = document.createElement('div');
                    ball.className = `ball ${getBallColor(num)}`;
                    ball.textContent = num;
                    container.appendChild(ball);

                    if (index === 5) {
                        saveHistory(selectedNumbers);
                        btn.disabled = false;
                    }
                }, index * 300);
            });
        }

        // 추첨 기록 저장
        function saveHistory(numbers) {
            const historyList = document.getElementById('historyList');
            const historyItem = document.createElement('div');
            historyItem.className = 'history-item';
            
            const timeString = new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute:'2-digit', second:'2-digit' });
            
            historyItem.innerHTML = `
                <span>${timeString}</span>
                <span class="history-nums">${numbers.join(', ')}</span>
            `;
            
            historyList.insertBefore(historyItem, historyList.firstChild);
            
            if (historyList.children.length > 5) {
                historyList.removeChild(historyList.lastChild);
            }
        }
    </script>
</body>
</html>